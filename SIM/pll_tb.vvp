:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/va_math.vpi";
S_0xbd06f65784f0 .scope module, "pll_tb" "pll_tb" 2 3;
 .timescale -9 -9;
v0xbd06f65c2fd0_0 .var "sys_clk", 0 0;
v0xbd06f65c30a0_0 .var "sys_rst_n", 0 0;
v0xbd06f65c3170_0 .net "vga_clk", 0 0, v0xbd06f65c2eb0_0;  1 drivers
S_0xbd06f6578680 .scope module, "dut" "pll" 2 8, 3 3 0, S_0xbd06f65784f0;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "sys_clk";
    .port_info 1 /INPUT 1 "sys_rst_n";
    .port_info 2 /OUTPUT 1 "vga_clk";
v0xbd06f65a18a0_0 .net "sys_clk", 0 0, v0xbd06f65c2fd0_0;  1 drivers
v0xbd06f65c2df0_0 .net "sys_rst_n", 0 0, v0xbd06f65c30a0_0;  1 drivers
v0xbd06f65c2eb0_0 .var "vga_clk", 0 0;
E_0xbd06f65a1fb0/0 .event negedge, v0xbd06f65c2df0_0;
E_0xbd06f65a1fb0/1 .event posedge, v0xbd06f65a18a0_0;
E_0xbd06f65a1fb0 .event/or E_0xbd06f65a1fb0/0, E_0xbd06f65a1fb0/1;
    .scope S_0xbd06f6578680;
T_0 ;
    %wait E_0xbd06f65a1fb0;
    %load/vec4 v0xbd06f65c2df0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0xbd06f65c2eb0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0xbd06f65c2eb0_0;
    %inv;
    %assign/vec4 v0xbd06f65c2eb0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0xbd06f65784f0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xbd06f65c2fd0_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0xbd06f65784f0;
T_2 ;
    %delay 10, 0;
    %load/vec4 v0xbd06f65c2fd0_0;
    %inv;
    %store/vec4 v0xbd06f65c2fd0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0xbd06f65784f0;
T_3 ;
    %vpi_call 2 18 "$dumpfile", "pll_tb.vcd" {0 0 0};
    %vpi_call 2 19 "$dumpvars", 32'sb00000000000000000000000000000000, S_0xbd06f65784f0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xbd06f65c30a0_0, 0, 1;
    %delay 25, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0xbd06f65c30a0_0, 0, 1;
    %delay 260, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xbd06f65c30a0_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0xbd06f65c30a0_0, 0, 1;
    %delay 200, 0;
    %vpi_call 2 27 "$finish" {0 0 0};
    %end;
    .thread T_3;
