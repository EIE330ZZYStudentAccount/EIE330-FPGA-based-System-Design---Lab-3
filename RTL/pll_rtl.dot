digraph "pll" {
label="pll";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="sys_clk", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="sys_rst_n", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="vga_clk", color="black", fontcolor="black" ];
c7 [ shape=record, label="{{<p5> A}|$3\n$not|{<p6> Y}}",  ];
c12 [ shape=record, label="{{<p8> ARST|<p9> CLK|<p10> D}|$4\n$adff|{<p11> Q}}",  ];
c7:p6:e -> c12:p10:w [color="black", fontcolor="black", label=""];
n2:e -> c12:p9:w [color="black", fontcolor="black", label=""];
n3:e -> c12:p8:w [color="black", fontcolor="black", label=""];
c12:p11:e -> n4:w [color="black", fontcolor="black", label=""];
n4:e -> c7:p5:w [color="black", fontcolor="black", label=""];
}
